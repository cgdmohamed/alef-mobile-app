{
  "name": "alif-future-platform",
  "private": true,
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:generate": "pnpm --filter @alif/api prisma:generate",
    "db:validate": "pnpm --filter @alif/api prisma:validate",
    "db:migrate": "pnpm --filter @alif/api prisma:migrate"
  },
  "devDependencies": {
    "turbo": "^2.5.6",
    "typescript": "^5.8.3"
  }
}
